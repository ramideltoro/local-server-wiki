---
import {marked} from 'marked';
import topics from '../data/topics.json';
const {topic,mode='technical'}=Astro.props;
const modes=['summary','technical','expert'];
const content=topic[mode];
const titles={summary:'The essentials, in plain language.',technical:'The architecture, configuration, and operation.',expert:'The reasoning, tradeoffs, and failure modes.'};
const groups=[...new Set(topics.map(t=>t.group))];
const release=process.env.WIKI_RELEASE||'Current documentation';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f3ead5"/><meta name="description" content={topic.description}/><title>{topic.title} · Local Server Wiki</title><link rel="canonical" href={`https://localserver.wiki.ramideltoro.com/${mode}/${topic.slug}/`}/><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='9' fill='%23e5aa3c'/%3E%3Cpath d='M10 10h8l2 3 2-3h8v21h-8l-2 2-2-2h-8z' fill='none' stroke='%234b3818' stroke-width='2'/%3E%3C/svg%3E"/></head><body data-mode={mode} data-topic={topic.slug}><aside><a class="brand" href="/"><span class="brand-icon">◫</span><span>Local Server<span class="brand-caption">THE INFRASTRUCTURE WIKI</span></span></a><div class="search-wrap"><span>⌕</span><input id="search" placeholder="Find a topic…" aria-label="Search documentation"/><kbd>/</kbd></div><nav>{groups.map(group=><section><h2>{group}</h2>{topics.filter(t=>t.group===group).map(t=><a data-topic-link data-title={t.title.toLowerCase()} href={`/${mode}/${t.slug}/`} class:list={['nav-link',{'active':t.slug===topic.slug}]}><span>{t.icon}</span>{t.title}{t.slug===topic.slug&&<i>›</i>}</a>)}</section>)}</nav><div class="aside-bottom"><a href="https://observe.ramideltoro.com" target="_blank" rel="noreferrer">↗ Open observability portal</a><a href="https://github.com/ramideltoro/local-server-wiki" target="_blank" rel="noreferrer">⌘ View source on GitHub</a><small>Knowledge that stays with your code.</small></div></aside><div class="page"><header><div class="crumb">Documentation <span>›</span><strong>{topic.group}</strong></div><div class="preference"><span class="preference-label">READING MODE</span><div class="mode-switch" role="group" aria-label="Reading preference">{modes.map(m=><a href={`/${m}/${topic.slug}/`} data-mode-link={m} aria-current={m===mode?'page':undefined} class:list={{selected:m===mode}}>{m[0].toUpperCase()+m.slice(1)}</a>)}</div></div></header><main><div class="article-header"><div class="eyebrow">{topic.group.toUpperCase()} <span> / </span> {mode.toUpperCase()}</div><h1>{topic.title}</h1><p class="description">{topic.description}</p><div class="article-meta"><span class="reading-dot"></span>{titles[mode as keyof typeof titles]}<span class="read-time">{Math.max(2,Math.ceil(content.split(/\s+/).length/180))} min read</span></div></div><div class="article-layout"><article id="article" set:html={marked.parse(content)}></article><div class="article-side"><div class="on-page"><h3>ON THIS PAGE</h3><div id="toc"></div></div><div class="depth-card"><span>THREE WAYS TO UNDERSTAND</span><h3>Same system.<br/>Your level of detail.</h3><p>Switch reading modes above to find the explanation that fits.</p><a href={`/${mode==='expert'?'technical':'expert'}/${topic.slug}/`}>Explore {mode==='expert'?'Technical':'Expert'} →</a></div></div></div><section class="next-topics"><h2>Keep exploring</h2><div>{topics.filter(t=>t.slug!==topic.slug&&t.group===topic.group).slice(0,2).map(t=><a href={`/${mode}/${t.slug}/`}><span>{t.title}</span><p>{t.description}</p><b>↗</b></a>)}</div></section><footer><span>{release}</span><a href={`https://github.com/ramideltoro/local-server-wiki/blob/main/src/data/topics.json`}>Edit this documentation ↗</a></footer></main></div>
<script>
const mode=document.body.dataset.mode||'technical';const slug=document.body.dataset.topic||'overview';
document.querySelectorAll<HTMLAnchorElement>('[data-mode-link]').forEach(a=>a.addEventListener('click',()=>{try{localStorage.setItem('wiki-reading-mode',a.dataset.modeLink||'technical')}catch{}}));
if(location.pathname==='/'){try{const saved=localStorage.getItem('wiki-reading-mode');if(saved&&saved!=='technical'&&['summary','expert'].includes(saved))location.replace('/'+saved+'/'+slug+'/')}catch{}}
const toc=document.getElementById('toc');document.querySelectorAll<HTMLHeadingElement>('article h2,article h3').forEach((h,i)=>{h.id=h.textContent?.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')||'section-'+i;const a=document.createElement('a');a.href='#'+h.id;a.textContent=h.textContent;a.className=h.tagName==='H3'?'nested':'';toc?.appendChild(a)});
const search=document.getElementById('search') as HTMLInputElement;search?.addEventListener('input',()=>{document.querySelectorAll<HTMLAnchorElement>('[data-topic-link]').forEach(a=>{a.hidden=!(a.dataset.title||'').includes(search.value.toLowerCase())})});document.addEventListener('keydown',e=>{if(e.key==='/'&&!(e.target instanceof HTMLInputElement)){e.preventDefault();search.focus()}});
</script>
<style is:global>
:root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#3c3427;background:#fdfbf6;font-size:14px}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:focus-visible,input:focus-visible{outline:3px solid #c28a27;outline-offset:3px}aside{position:fixed;inset:0 auto 0 0;width:266px;background:#f3eddf;border-right:1px solid #e6dcc6;padding:32px 20px;display:flex;flex-direction:column}.brand{display:flex;gap:11px;align-items:center;font-size:19px;letter-spacing:-.5px;font-weight:600;padding:0 8px}.brand-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:9px;background:#e9b657;color:#644715;font-size:27px}.brand-caption{display:block;font-size:8px;letter-spacing:1.5px;font-weight:500;color:#a08961;margin-top:5px}.search-wrap{display:flex;gap:9px;align-items:center;padding:10px 12px;border:1px solid #e2d7c1;background:#faf6ee;border-radius:7px;margin:29px 0 25px;color:#a18a64}.search-wrap input{width:100%;min-width:0;border:0;outline:0;background:none;font-size:11px;color:#7a6646}.search-wrap kbd{border:1px solid #e0d4be;border-radius:3px;font-size:9px;padding:1px 5px}.search-wrap>span{font-size:20px;line-height:10px}nav{overflow:auto}nav section{margin-bottom:25px}nav h2{font-size:8px;font-weight:650;letter-spacing:1.6px;text-transform:uppercase;color:#a18e6a;margin:0 10px 11px}.nav-link{display:flex;align-items:center;gap:10px;padding:10px;border-radius:6px;font-size:11px;color:#8b7b5f;margin:3px 0}.nav-link[hidden]{display:none}.nav-link>span{width:16px;color:#b39b70}.nav-link.active{background:#e9dbba;color:#886021;box-shadow:inset 2px 0 #c89635}.nav-link i{margin-left:auto;font-size:17px;font-style:normal}.nav-link:hover{background:#ebe2ce}.aside-bottom{margin-top:auto;padding:25px 8px 0}.aside-bottom a{display:block;font-size:10px;color:#98825d;padding:10px 0}.aside-bottom small{display:block;border-top:1px solid #dfd2b9;padding-top:19px;margin-top:12px;color:#b5a285;font-size:9px}.page{margin-left:266px}header{height:82px;border-bottom:1px solid #eae3d5;display:flex;align-items:center;justify-content:space-between;padding:0 48px;gap:20px;background:#fffcf6}.crumb{font-size:10px;color:#a29276;display:flex;gap:13px}.crumb strong{font-weight:400;color:#756244}.preference{display:flex;align-items:center;gap:12px}.preference-label{font-size:7px;letter-spacing:1.3px;color:#ae9873}.mode-switch{display:flex;gap:3px;border:1px solid #e3d6bd;border-radius:7px;padding:3px;background:#f5eee0}.mode-switch a{font-size:10px;padding:7px 11px;border-radius:4px;color:#9e8459}.mode-switch a.selected{background:#e8b654;color:#624312;box-shadow:0 1px 3px #9e752124;font-weight:600}main{max-width:1220px;margin:auto;padding:50px 48px 22px}.eyebrow{font-size:8px;letter-spacing:1.6px;color:#b38b41;font-weight:600}.eyebrow span{padding:0 8px;color:#d0b984}h1{font-size:39px;letter-spacing:-1.2px;font-weight:550;line-height:1.16;margin:19px 0 14px}.description{font-size:14px;line-height:1.8;color:#988567;max-width:650px;margin:0}.article-meta{display:flex;align-items:center;gap:8px;font-size:10px;color:#ae9979;padding:20px 0 27px;border-bottom:1px solid #e9dfcc;margin-bottom:32px}.reading-dot{width:5px;height:5px;border-radius:50%;background:#cea34e}.read-time{margin-left:12px;padding-left:18px;border-left:1px solid #dfcfb1;font-size:9px}.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:52px}article{font-size:13px;line-height:1.9;color:#79684e}article h2{font-size:20px;line-height:1.3;font-weight:550;letter-spacing:-.3px;color:#453923;margin:35px 0 15px;scroll-margin-top:25px}article h2:first-child{margin-top:0}article h3{font-size:15px;color:#655032;margin:25px 0 10px}article p{margin:14px 0}article a{color:#ad7c26;text-decoration:underline;text-underline-offset:3px}article ul,article ol{padding-left:22px}article li{padding-left:3px;margin:7px 0}article li::marker{color:#bb903f}article strong{color:#584528;font-weight:600}article code{font-family:ui-monospace,SFMono-Regular,monospace;font-size:11px;background:#f2ecdf;padding:3px 5px;border-radius:4px;color:#9a712d;overflow-wrap:anywhere}article pre{background:#272319;border:1px solid #433b2a;color:#e8d5ab;border-radius:9px;padding:21px;overflow:auto;margin:24px 0}article pre code{background:none;color:inherit;font-size:11px;padding:0;white-space:pre}article blockquote{margin:25px 0;padding:13px 20px;border-left:3px solid #d5a043;background:#f4ebd6;border-radius:0 7px 7px 0;color:#92723c;font-size:12px}article blockquote p{margin:3px 0}article table{border-collapse:collapse;width:100%;font-size:11px;margin:22px 0}article th,article td{border-bottom:1px solid #e6dcc7;padding:12px 9px;text-align:left}article th{color:#816338;background:#f4eedf}article hr{border:0;border-top:1px solid #e6dcc7;margin:28px 0}.on-page{border-left:1px solid #e8ddc8;padding-left:18px}.on-page h3{font-size:8px;letter-spacing:1.4px;color:#a28c66;margin:4px 0 16px}#toc a{display:block;font-size:10px;color:#a38f6d;line-height:1.6;margin:11px 0}#toc a:hover{color:#986719}#toc a.nested{padding-left:10px;font-size:9px}.depth-card{margin-top:35px;border:1px solid #e4d6b7;background:#f4ead4;padding:19px;border-radius:8px}.depth-card>span{font-size:6px;letter-spacing:1.1px;color:#b0935a}.depth-card h3{font-size:16px;font-weight:550;line-height:1.35;color:#7b5d2e;margin:14px 0}.depth-card p{font-size:10px;line-height:1.8;color:#a38b60}.depth-card a{font-size:10px;color:#967027;display:block;margin-top:18px}.next-topics{border-top:1px solid #e8deca;margin-top:40px;padding-top:25px}.next-topics h2{font-size:11px;font-weight:500;color:#aa9066;margin:0 0 15px}.next-topics>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.next-topics a{display:block;position:relative;padding:20px 35px 17px 20px;border:1px solid #e8dcc5;border-radius:8px;background:#fcf8ef}.next-topics span{font-size:12px;color:#836336}.next-topics p{font-size:10px;line-height:1.7;color:#ae9975;margin:8px 0 0}.next-topics b{position:absolute;right:18px;top:18px;font-weight:400;color:#b29a6e}footer{display:flex;justify-content:space-between;font-size:9px;color:#b6a587;margin-top:40px;border-top:1px solid #e8deca;padding-top:20px;gap:15px}@media(min-width:1500px){main{padding-top:65px}.article-layout{gap:70px}}@media(max-width:1150px){aside{width:230px}.page{margin-left:230px}header{padding:0 30px}.preference-label{display:none}main{padding:40px 30px 22px}.article-layout{grid-template-columns:minmax(0,1fr) 150px;gap:28px}h1{font-size:33px}}@media(max-width:900px){.article-layout{grid-template-columns:1fr}.article-side{display:none}.crumb{display:none}header{justify-content:flex-end}.description{font-size:13px}aside{width:205px;padding:27px 13px}.page{margin-left:205px}.brand{font-size:16px}.brand-caption{font-size:6px}.brand-icon{width:32px;height:32px}.read-time{display:none}}@media(max-width:620px){aside{position:relative;width:100%;padding:18px 20px;border-right:0;border-bottom:1px solid #e2d7bf}.brand{font-size:18px}.brand-caption{font-size:7px}.search-wrap{margin:17px 0 0}nav{display:flex;gap:18px;margin-top:16px;overflow:auto}nav section{display:contents}nav h2{display:none}.nav-link{white-space:nowrap;font-size:10px;padding:8px;gap:5px;margin:0}.nav-link i{display:none}.aside-bottom{display:none}.page{margin:0}header{height:65px;padding:0 20px;position:sticky;top:0;z-index:3;justify-content:space-between}.preference-label{display:block;font-size:7px}.preference{justify-content:space-between;width:100%}.mode-switch a{padding:7px 10px}main{padding:32px 22px 20px}h1{font-size:30px}.eyebrow{font-size:7px}.article-meta{font-size:9px;line-height:1.6;margin-bottom:25px}article{font-size:12px}article h2{font-size:18px}.next-topics>div{grid-template-columns:1fr}footer{font-size:8px}}
</style></body></html>
